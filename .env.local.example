# Frontend URL used by Better Auth. Keep this aligned with the address in your browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Neon PostgreSQL connection string (use the connection string from your Neon dashboard).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Existing Express content API (currently used by the search panel).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
